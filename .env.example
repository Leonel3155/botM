# =============================================================
#  BotM: variables de entorno
#  Copia este archivo como ".env" (en la misma carpeta) y llena los valores.
#  Nunca compartas ni subas tu .env: tiene las llaves de tu bot.
# =============================================================

# ----- Discord (https://discord.com/developers/applications) -----

# Token del bot: Bot → Reset Token. Es secreto: si se filtra, genera otro.
DISCORD_TOKEN=pega_aqui_el_token_del_bot

# ID de la aplicación: General Information → Application ID (un número largo).
DISCORD_CLIENT_ID=123456789012345678

# Secreto OAuth para iniciar sesión en el panel: OAuth2 → Client Secret → Reset Secret.
DISCORD_CLIENT_SECRET=pega_aqui_el_client_secret

# ----- Base de datos (PostgreSQL) -----

# Cadena de conexión de Neon (https://neon.tech, gratis): Dashboard → Connection string.
# Debe terminar en ?sslmode=require
DATABASE_URL=postgresql://usuario:contrasena@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ----- Panel web -----

# Clave para firmar las sesiones del panel: texto aleatorio de al menos 32 caracteres.
# Para generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_esto_por_una_clave_aleatoria_muy_larga_de_al_menos_32_caracteres

# URL pública del servidor, sin "/" al final. En tu computadora: http://localhost:5000
# Discord redirige el login a APP_URL + /auth/discord/callback (debe estar en OAuth2 → Redirects).
APP_URL=http://localhost:5000

# URL del panel. Si el panel y el servidor van juntos (lo normal), el mismo valor que APP_URL.
FRONTEND_URL=http://localhost:5000

# Puerto donde escucha el servidor (por defecto 5000).
PORT=5000

# ----- Opcionales -----

# Solo para desarrollo: con 1 aparece /auth/dev-login, que entra al panel SIN Discord y ve
# todos los servidores del bot. Solo funciona con "npm run dev". Nunca lo actives en producción.
# DEV_BYPASS_AUTH=0

# Ajustes de la cola interna de tareas del bot (puedes dejarlos así).
# GLOBAL_CONCURRENCY=50
# GLOBAL_TIMEOUT_MS=120000

# Twitter/X: los feeds de Twitter están desactivados en el panel; por ahora no hace falta.
# TWITTER_BEARER_TOKEN=
# X_BEARER_TOKEN=

# NODE_ENV no se pone aquí: "npm run dev" usa development y "npm start" usa production.
